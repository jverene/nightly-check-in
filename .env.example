# --- Required ---
# Postgres connection string (Neon, Supabase, or local). Pooled endpoint recommended on Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nightly
# Secret used to pepper PIN/password hashes. Generate: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string

# --- Study configuration ---
# IANA timezone of the school. All check-in dates, windows, and countdowns use this.
APP_TIMEZONE=America/Toronto
# Weekdays (of the night itself) that are school nights: 0=Sun 1=Mon ... 6=Sat.
SCHOOL_NIGHTS=0,1,2,3,4
# Public base URL, used to build claim URLs on printed strips and in QR codes.
APP_BASE_URL=http://localhost:3000

# --- Web push (optional reminders). Generate: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:sponsor@example.com

# --- Cron ---
# Vercel Cron sends this as a Bearer token; set any long random string.
CRON_SECRET=change-me-too

# --- Seed accounts (used by scripts/seed.ts only) ---
SEED_SPONSOR_EMAIL=sponsor@example.com
SEED_SPONSOR_PASSWORD=change-this-password
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=change-this-password

# --- DANGER: local testing only, NEVER set in production ---
# When "true", /api/today and /api/checkin honor an x-test-now header so the
# submission window and Sunday supplements can be exercised out of hours.
CHECKIN_WINDOW_OVERRIDE=false
